# Production / homelab environment template.
# Copy to `.env` on the VPS and fill in the values. Never commit the real .env.

APP_NAME=Roam
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://roam.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Shared MySQL (homelab) — point at your mysql-shared service/container.
DB_CONNECTION=mysql
DB_HOST=mysql-shared
DB_PORT=3306
DB_DATABASE=roam
DB_USERNAME=roam
DB_PASSWORD=change-me

# Bootstrap admin (created on first boot by the entrypoint).
ADMIN_NAME="Roam Admin"
ADMIN_EMAIL=admin@roam.example.com
ADMIN_PASSWORD=change-me-too

# Demo dataset + one-click demo logins. Turn BOTH off for a real deployment.
ROAM_SEED_DEMO=true
ROAM_DEMO_LOGIN=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@roam.example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Video processing: "ffmpeg" (installed in the image) or "fake".
ROAM_VIDEO_PROCESSOR=ffmpeg
ROAM_VIDEO_DISK=public

# Traefik host routing (used by docker-compose.prod.yml labels).
APP_HOST=roam.example.com
MAIL_HOST=mail.roam.example.com
